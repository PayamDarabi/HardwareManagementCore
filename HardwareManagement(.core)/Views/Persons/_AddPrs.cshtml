@model  HardwareManagement_.core_.Models.Entity.TblPerson
<form asp-controlller="Persons" asp-action="Create" method="post">
    <div class="row">
        <div class="col-md-6">
            @Html.EditorFor(m=>m.Name)
        </div>
        <div class="col-md-6">
            @Html.EditorFor(m => m.PersonId)
        </div>
        <div class="col-md-6">
            @Html.EditorFor(m => m.Unit)
        </div>
    </div>
    <button type="submit" class="btn btn-success">add</button>
    </form>