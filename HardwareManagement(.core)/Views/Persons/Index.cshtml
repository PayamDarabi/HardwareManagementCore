@using HardwareManagement_.core_.Models;
@using System.Windows.Forms;
@model IEnumerable< Tuple<HardwareManagement_.core_.Models.Entity.TblPerson,HardwareManagement_.core_.Models.Entity.TblUnit>>


@{
    var counter = 1;
}

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!DOCTYPE html>
<html lang="en" dir="ltr" data-critters-container="" data-bs-theme="light">

<div class="content-header">
    <h1 align="center">
        سامانه مدیریت تجهیزات رایانه ای
    </h1>
    <o1 class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> مدیریت کارکنان</a></li>
        <li class="active">افزودن کاربر</li>
      </o1>
   </div>
<div class="content">
    <div class="row" >
        <div class="col-md-12">
            <div class="box box-solid ">
                <div class="box-header with-border">
                    <h3 class="box-title">افزودن افراد</h3>
                    <div class="box-tools">
                        <button type="button" class="btn btn-box-tool" data-widget="collapse">
                            <i class="fa fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="box-body no-padding">
                    <form asp-action="Create" asp-controller="Persons">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <ul class="nav nav-pills nav-stacked">
                            <li>
                                  <div class="col-xs-4">
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">نام فرد</span>
                                        </div>
                                        <input type="text" class="form-control" id="name" placeholder="Enter Name" name="name">
                                    </div>
                                </div>
                                 <div class="col-xs-4">
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">شماره پرسنلی</span>
                                        </div>
                                        <input type="text" class="form-control" id="PersonId" placeholder="Enter Name" name="PersonId">
                                    </div>
                                </div>
                            </li>
                            <li>
                                <div class="col-xs-4">
                                   <form asp-controller="Units" asp-action="index" method="post" >
                                     <div class="form-group">
                                     <div class="alert danger" asp-validation-summary="ModelOnly" ></div>
                                 
                                      @*  <select asp-for="Id"  class="form-control" asp-items="@(new SelectList( ViewBag.ListOfunit,"Value","Text"))"> </select>
                                                            
                                      </div> *@
                                        
                                    </form>
                                 </div>
                                <div class="col-xs-4">
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">شماره پرسنلی</span>
                                        </div>
                                        <input type="text" class="form-control" id="PersonId" placeholder="Enter Name" name="PersonId">
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </form>
                </div>
            </div>
        </div>
           
       
    <div class="col-md-12">
            <div class="box box-primery">
                <div class="box-body P-0">
                    <table id="example1" class="table table-bordered table-striped dataTable">
                        <thead style="background-color:darksalmon">
                            <tr>
                                <th style="width: 20px; text-align:center;">
                                    ردیف
                                </th>
                                <th class="sorting_asc" tabindex="0" aria-controls="example1" rowspan="1" colspan="1" aria-label="انواع سخت افزارها: activate to sort column descending"
                                    aria-sort="ascending">نام افراد </th>
                                <th class="sorting_asc" tabindex="0" aria-controls="example1" rowspan="1" colspan="1" aria-label="انواع سخت افزارها: activate to sort column descending"
                                aria-sort="ascending">شماره پرسنلی </th>
                                <th class="sorting_asc" tabindex="0" aria-controls="example1" rowspan="1" colspan="1" aria-label="انواع سخت افزارها: activate to sort column descending"
                                    aria-sort="ascending">واحد </th>
                                <th class="sorting_asc" tabindex="0" aria-controls="example1" rowspan="1" colspan="1" aria-label="انواع سخت افزارها: activate to sort column descending"
                                aria-sort="ascending">شماره تماس </th>
                               <th class="sorting_asc" tabindex="0" aria-controls="example1" rowspan="1" colspan="1" aria-label="انواع سخت افزارها: activate to sort column descending"
                                aria-sort="ascending">شماره اتاق </th>
                                <th class="sorting_asc" tabindex="0" aria-controls="example1" rowspan="1" colspan="1" aria-label="انواع سخت افزارها: activate to sort column descending"
                                    aria-sort="ascending">وضعیت </th>
                                <th class="sorting_asc" tabindex="0" aria-controls="example1" rowspan="1" colspan="1" aria-label="انواع سخت افزارها: activate to sort column descending"
                                aria-sort="ascending">توضیحات </th>
                                <th style="width: 45px;  align-content:center;">
                                    عملیات
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                            {
                                <tr>
                                    <td style="text-align:center;">
                                        @counter
                                    </td>
                                    <td>
                                    @Html.DisplayFor(modelItem => item.Item1.Name))
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem =>item.Item1.PersonId)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Item1.Unit)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Item1.Phone)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Item1.RoomNo)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Item1.Status)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Item1.Note)
                                    </td>
                                    <td style="text-align:center;">
                                        <form method="post" asp-action="Delete" asp-route-id="@item.Item1.PersonId">
                                            @Html.AntiForgeryToken()
                                            @*  <input type="button" class="btn btn-sm btn-default" data-placement="top" data-toggle="tooltip" style="background-color:lightseagreen" data-original-title="سطل آشغال" /> *@

                                            <button class="btn btn-sm btn-default" type="submit" data-placement="top" data-toggle="tooltip" data-original-title="سطل آشغال" style="background-color:lightsteelblue">
                                                <i class="fa fa-trash-o"></i>
                                            </button>

                                        </form>

                                    </td>
                                </tr>
                                counter += 1;
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
   
    <!-- jQuery 3 -->
    <script src="../../bower_components/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap 3.3.7 -->
    <script src="../../bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <!-- DataTables -->
    <script src="../../bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="../../bower_components/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
    <!-- SlimScroll -->
    <script src="../../bower_components/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <!-- FastClick -->
    <script src="../../bower_components/fastclick/lib/fastclick.js"></script>
    <!-- AdminLTE App -->
    <script src="../../dist/js/adminlte.min.js"></script>
    <!-- AdminLTE for demo purposes -->
    <script src="../../dist/js/demo.js"></script>
    <!-- page script -->
    <script>
        $(function () {
            $('#example1').DataTable()
            $('#example2').DataTable({
                'paging': true,
                'lengthChange': false,
                'searching': false,
                'ordering': true,
                'info': true,
                'autoWidth': false
            })
        })
    </script>
</div>
</html>
