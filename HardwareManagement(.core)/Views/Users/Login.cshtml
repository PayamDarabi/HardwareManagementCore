@model HardwareManagement_.core_.Models.Entity.TblUser
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title> Login Form </title>

<meta name="author" content="Codeconvey">

<!-- Style CSS -->
<link rel="stylesheet" href="./css/style.css">

<!--Only for demo purpose - no need to add.-->
<link rel="stylesheet" type="text/css" href="./css/demo.css">

</head>
<body>

    <section>
        <div class="rt-container">
            <div class="col-rt-12">
     <div class="Scriptcontent">
            @using (Html.BeginForm("Login", "Users", FormMethod.Post))

            {
                <section>
                            <div class="box" style="position:fixed; top:40%; left:50%; transform:translate(-50%,-50%); ">
               
                            <div class="square" style="--i:0;"></div>
                            <div class="square" style="--i:1;"></div>
                            <div class="square" style="--i:2;"></div>
                            <div class="square" style="--i:3;"></div>
                            <div class="square" style="--i:4;"></div>
                            <div class="square" style="--i:5;"></div>

                            <div class="container">
                                
                                <div class="form">
                                        <h2 >Wellcom</h2>
                                    <form asp-action="Login" asp-controller="Users" method="post">
                                        <div class="inputBx" type="text">
                                          @*   <input type="text" class="inputBx" required="required"> *@
                                            @Html.TextBoxFor(m => m.UserName, new { @class = "form" })
                                            <span asp-validation-for="UserName" class="text-danger" class="icon-inside">UserName</span>
                                            <i class="fas fa-user-circle"></i>
                                        </div>

                                        <div class="inputBx password" type="password">
                                          @*  <input id="password-input" type="password" class="inputBx password" name="password" required="required"> *@
                                            @Html.PasswordFor(m => m.Password, new { @class = "form"})
                                            <span asp-validation-for="Password" class="text-danger" class="icon-inside">Password</span>
                                                <a href="#" class="password-control" onclick="return show_hide_password();"></a>
                                            <i class="fas fa-key"></i>
                                               
                                         </div>
                                           
                                        <label class="remember">
                                            <input type="checkbox">
                                            Remember
                                        </label>
                                        <div class="inputBx">
                                                <input type="submit" value="Log in" />
                                        </div>
                                    </form>
                                 </div>
                                 
                            </div>
       
                        </div>
                           
            </section>
            }
      </div>
                         
    

    <!-- ANALYTICS -->
            </div>
        </div>
    </section>
    <script type="text/javascript" src="./js/script.js"></script>
</body>
</html>