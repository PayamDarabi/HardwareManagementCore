        <Dictionary isRef="1" />
        <Key>bcf351c7caef4f77be871666d152b159</Key>
        <Name>Bazresi</Name>
        <NameInSource>Bazresi</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT dbo.tblHardwares.Title, dbo.tblHardwares.Model, dbo.tblHardwares.AssetNo,
  dbo.tblHardwares.Location, dbo.tblPerson.Name, dbo.tblHardwares.SerialNo
FROM dbo.tblHardwares INNER JOIN
  dbo.tblPerson ON dbo.tblHardwares.PersonId COLLATE Arabic_CI_AS =
    dbo.tblPerson.PersonId
WHERE (dbo.tblPerson.Unit = N'بازرسی فنی(ط 9)')</SqlCommand>
      </Bazresi>
    </DataSources>
