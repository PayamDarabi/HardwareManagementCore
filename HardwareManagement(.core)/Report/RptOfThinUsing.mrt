        <Dictionary isRef="1" />
        <Key>ded731035319477d8c32cb765bcd0205</Key>
        <Name>ThinUsing</Name>
        <NameInSource>ThinUsing</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT dbo.tblHardwares.Model, dbo.tblHardwares.AssetNo,
  dbo.tblHardwares.SerialNo, dbo.tblPerson.Name, dbo.tblPerson.Unit,
  dbo.tblHardwares.Location
FROM dbo.tblHardwares LEFT OUTER JOIN
  dbo.tblPerson ON dbo.tblHardwares.PersonId COLLATE Arabic_CI_AS =
    dbo.tblPerson.PersonId
WHERE (dbo.tblHardwares.Title = 'thin client') AND (dbo.tblHardwares.StatusHw =
    'در حال استفاده')</SqlCommand>
      </ThinUsing>
    </DataSources>
